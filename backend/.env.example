# OpenAI-compatible model gateway. Keep secrets only on the server.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# AMap Web Service key (server-side only).
AMAP_API_KEY=

# Development may return clearly marked FALLBACK data when a provider is absent.
# Set false in production so missing providers fail loudly.
ALLOW_DEMO_FALLBACK=true
CORS_ORIGINS=*
