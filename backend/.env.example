# ================= 大模型（OpenAI 兼容接口，默认 DeepSeek）=================
# 密钥只放在服务端；鸿蒙客户端与技能脚本永远不保存任何第三方密钥。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，填旧名会被 DeepSeek 拒绝（HTTP 400，提示模型名不受支持）。
# deepseek-flash = 当前最新 Flash 模型（快、便宜，适合意图理解）；想要更强效果可改 deepseek-v4-pro
LLM_MODEL=deepseek-flash
# DeepSeek 默认开启思考模式，响应慢且会超出客户端 15 秒超时。
# auto = 对 DeepSeek 自动关闭思考、对其他服务商不发送该参数；可选 auto | disabled | enabled | omit
LLM_THINKING=auto
LLM_MAX_TOKENS=1024
# 网关等待模型的总时长（秒），必须小于客户端读超时 15 秒
LLM_TIMEOUT_S=12

# ================= 高德 Web 服务（天气 / 路线 / 医院检索）=================
# 在高德开放平台创建「Web服务」类型的 Key（不是 Android / iOS / HarmonyOS SDK 的 Key）
AMAP_API_KEY=

# ================= 访问控制 =================
# 非空时，客户端必须携带请求头 X-App-Token，值与这里一致：
#   App：entry/src/main/ets/config/BackendConfig.ets 的 APP_TOKEN
#   技能：entry/skills/travel-plan/scripts/TravelPlanSkill.ets 的 GATEWAY_APP_TOKEN
APP_ACCESS_TOKEN=
# 每个 IP 每分钟的请求上限；0 表示不限
RATE_LIMIT_PER_MIN=60
LLM_RATE_LIMIT_PER_MIN=20
# 部署在 Nginx 等反向代理之后时设为 true，按 X-Forwarded-For 识别客户端 IP
TRUST_PROXY_HEADERS=false

# ================= 其他 =================
# 未配置密钥或调用失败时，是否返回带 FALLBACK 标识的演示 / 估算数据。
# 答辩演示建议 true（断网也能跑通）；正式环境设为 false，让问题直接暴露。
ALLOW_DEMO_FALLBACK=true
CORS_ORIGINS=*
