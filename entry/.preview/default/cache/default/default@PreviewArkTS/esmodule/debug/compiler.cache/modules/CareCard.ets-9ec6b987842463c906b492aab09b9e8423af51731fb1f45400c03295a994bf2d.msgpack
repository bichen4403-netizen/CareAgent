const storage = new LocalStorage();

@Entry(storage)
@Component
struct CareCard {
  @LocalStorageProp('hasPlan') hasPlan: boolean = false;
  @LocalStorageProp('title') title: string = 'è¿˜æ²¡æœ‰é™ªè¯Šå®‰æŽ’';
  @LocalStorageProp('nextAction') nextAction: string = 'ç‚¹ä¸€ä¸‹ï¼Œè¯´å¥è¯å°±èƒ½å®‰æŽ’';
  @LocalStorageProp('detail') detail: string = '';
  @LocalStorageProp('hospital') hospital: string = '';
  @LocalStorageProp('stepIndex') stepIndex: number = 0;
  @LocalStorageProp('stepTotal') stepTotal: number = 0;

  /** ç‚¹å‡»å¡ç‰‡æ‹‰èµ·ä¸»åº”ç”¨ */
  private openApp(): void {
    postCardAction(this, {
      action: 'router',
      abilityName: 'EntryAbility',
      params: {
        'from': 'card'
      }
    });
  }

  build() {
    Column() {
      // é¡¶éƒ¨å“ç‰Œè¡Œ
      Row() {
        Text('æ™ºæŠ¤åŒè¡Œ')
          .fontSize(13)
          .fontColor('#7A8A96')
        Blank()
        if (this.hasPlan && this.stepTotal > 0) {
          Text(`${this.stepIndex}/${this.stepTotal}`)
            .fontSize(12)
            .fontColor('#2E6F8E')
            .padding({ left: 7, right: 7, top: 2, bottom: 2 })
            .backgroundColor('#E3EEF4')
            .borderRadius(8)
        }
      }
      .width('100%')
      .margin({ bottom: 8 })

      if (this.hasPlan) {
        // ä¸»ä¿¡æ¯ï¼šä¸‹ä¸€æ­¥åŠ¨ä½œï¼Œæœ€å¤§å­—å·
        Text(this.nextAction)
          .fontSize(22)
          .fontWeight(FontWeight.Bold)
          .fontColor('#1B2A34')
          .width('100%')
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })

        Text(this.title)
          .fontSize(15)
          .fontColor('#4A5A66')
          .width('100%')
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .margin({ top: 5 })

        if (this.detail.length > 0) {
          Text(this.detail)
            .fontSize(13)
            .fontColor('#E8874A')
            .width('100%')
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .margin({ top: 6 })
        }

        Blank()

        if (this.hospital.length > 0) {
          Text(this.hospital)
            .fontSize(12)
            .fontColor('#8A9AA6')
            .width('100%')
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
      } else {
        // ç©ºæ€ï¼šå¼•å¯¼ç”¨æˆ·å¼€å£
        Column() {
          Text(this.title)
            .fontSize(18)
            .fontWeight(FontWeight.Medium)
            .fontColor('#4A5A66')
          Text(this.nextAction)
            .fontSize(14)
            .fontColor('#8A9AA6')
            .margin({ top: 6 })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Start)
      }
    }
    .width('100%')
    .height('100%')
    .padding(16)
    .alignItems(HorizontalAlign.Start)
    .backgroundColor('#FFFFFF')
    .borderRadius(20)
    .onClick(() => {
      this.openApp();
    })
  }
}
