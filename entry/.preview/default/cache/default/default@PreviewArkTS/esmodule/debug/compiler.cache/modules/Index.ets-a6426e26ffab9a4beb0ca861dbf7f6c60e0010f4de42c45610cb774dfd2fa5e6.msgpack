            chronicTags: ['é«˜è¡€å‹'],
            accessibilityMode: true,
            emergencyContact: '13800000000'
        });
        await store.addRecord({
            recordId: 'r001',
            hospital: 'å¸‚ç¬¬ä¸€äººæ°‘åŒ»é™¢',
            department: 'å¿ƒè¡€ç®¡å†…ç§‘',
            doctorName: 'ç‹å»ºå›½ ä¸»ä»»åŒ»å¸ˆ',
            visitDate: '2026-07-20',
            followUpDays: 30,
            prescription: 'è‹¯ç£ºé…¸æ°¨æ°¯åœ°å¹³ç‰‡ æ¯æ—¥1æ¬¡ æ¯æ¬¡5mg',
            source: RecordSource.MANUAL_INPUT,
            confirmed: true // æ¼”ç¤ºæ•°æ®è§†ä¸ºå·²æ ¸å®ï¼ŒçœŸå®åœºæ™¯ä¸‹å¿…é¡»èµ°ç”¨æˆ·ç¡®è®¤
        });
    }
    /** è®¢é˜… Agent å±‚äº‹ä»¶ï¼Œé©±åŠ¨ UI æ›´æ–° */
    bindEvents() {
        eventBus.on(BusEvent.PLAN_UPDATED, (msg) => {
            const plan = JSON.parse(msg.payload);
            const list = [];
            for (let i = 0; i < plan.nodes.length; i++) {
                const n = plan.nodes[i];
                list.push(new ProgressItem(n.id, n.title, n.status));
            }
            this.progress = list;
        });
        eventBus.on(BusEvent.TASK_STARTED, (msg) => {
            const obj = JSON.parse(msg.payload);
            this.updateProgress(obj['taskId'], 'RUNNING');
        });
        eventBus.on(BusEvent.TASK_FINISHED, (msg) => {
            const r = JSON.parse(msg.payload);
            this.updateProgress(r.taskId, r.success ? 'SUCCESS' : 'FAILED');
        });
        eventBus.on(BusEvent.SPEAK, (msg) => {
            const obj = JSON.parse(msg.payload);
            this.pushChat('assistant', obj['text']);
        });
        eventBus.on(BusEvent.ANOMALY_DETECTED, () => {
            this.progress = [];
        });
    }
    updateProgress(taskId, status) {
        const list = [];
        for (let i = 0; i < this.progress.length; i++) {
            const p = this.progress[i];
            if (p.taskId === taskId) {
                list.push(new ProgressItem(p.taskId, p.title, status));
            }
            else {
                list.push(p);
            }
        }
        this.progress = list;
    }
    pushChat(role, text) {
        this.chats.push(new ChatItem(role, text));
        setTimeout(() => {
            this.scroller.scrollEdge(Edge.Bottom);
        }, 80);
    }
    /** å‘èµ·ä¸€æ¬¡è¯·æ±‚ */
    async submit(text) {
        if (text.length === 0 || this.busy) {
            return;
        }
        this.busy = true;
        this.pushChat('user', text);
        this.inputText = '';
        try {
            const rt = await this.buildRuntimeContext();
            const clarify = await this.central.handleUserRequest(text, rt);
            if (clarify.length > 0) {
                this.pushChat('assistant', clarify);
            }
        }
        catch (e) {
            this.pushChat('assistant', 'åˆšæ‰æ²¡å¤„ç†å¥½ï¼Œæ‚¨å†è¯´ä¸€æ¬¡å¥½å—');
            console.error(`[Index] submit error: ${e}`);
        }
        finally {
            this.busy = false;
        }
    }
    // ==================== æ‹ç…§å½•å…¥ç—…å† ====================
    /**
     * ç”¨æˆ·ç‚¹"æ‹ç…§å½•å…¥"ï¼šé€‰ç…§ç‰‡ â†’ OCR â†’ å¤§æ¨¡å‹ç»“æ„åŒ– â†’ å¼¹å‡ºå¾…ç¡®è®¤å¡ç‰‡
     * å…¨ç¨‹ä¸ç›´æ¥å†™å…¥æ­£å¼ç—…å†ï¼Œå¿…é¡»ç­‰ç”¨æˆ·ç‚¹"ç¡®è®¤æ— è¯¯"æ‰ç”Ÿæ•ˆï¼ˆè§ onConfirmPendingRecordï¼‰
     */
    async onCapturePhoto() {
        if (this.capturingOcr) {
            return;
        }
        this.capturingOcr = true;
        try {
            const picker = new photoAccessHelper.PhotoViewPicker();
            const result = await picker.select({
                MIMEType: photoAccessHelper.PhotoViewMIMETypes.IMAGE_TYPE,
                maxSelectNumber: 1
            });
            if (result.photoUris === undefined || result.photoUris.length === 0) {
                this.capturingOcr = false;
                return;
            }
            const pixelMap = await this.loadPixelMap(result.photoUris[0]);
            const record = await OcrCaptureService.captureFromPhoto(pixelMap);
            if (record === null) {
                this.pushChat('assistant', 'è¿™å¼ ç…§ç‰‡æ²¡èƒ½è¯†åˆ«å‡ºç—…å†ä¿¡æ¯ï¼Œè¦ä¸æ¢ä¸€å¼ æ¸…æ¥šç‚¹çš„è¯•è¯•');
            }
            else {
                this.pendingRecord = record;
            }
        }
        catch (e) {
            console.error(`[Index] capture photo failed: ${e}`);
            this.pushChat('assistant', 'æ‹ç…§è¯†åˆ«æ²¡æˆåŠŸï¼Œæ‚¨å¯ä»¥å†è¯•ä¸€æ¬¡');
        }
        finally {
            this.capturingOcr = false;
        }
    }
    /** æŠŠç…§ç‰‡ URI è¯»æˆ PixelMapï¼Œä¾› OCR ä½¿ç”¨ */
    async loadPixelMap(uri) {
        const file = await fileIo.open(uri, fileIo.OpenMode.READ_ONLY);
        try {
            const source = image.createImageSource(file.fd);
            const pixelMap = await source.createPixelMap();
            await source.release();
            return pixelMap;
        }
        finally {
            await fileIo.close(file.fd);
        }
    }
    /** ç”¨æˆ·ç‚¹"ç¡®è®¤æ— è¯¯"ï¼šè¿™æ—¶å€™æ‰çœŸæ­£å†™å…¥ç—…å†åº“ */
    async onConfirmPendingRecord() {
        if (this.pendingRecord === null) {
            return;
        }
        const confirmed = {
            recordId: this.pendingRecord.recordId,
            hospital: this.pendingRecord.hospital,
            department: this.pendingRecord.department,
            doctorName: this.pendingRecord.doctorName,
            visitDate: this.pendingRecord.visitDate,
            followUpDays: this.pendingRecord.followUpDays,
            prescription: this.pendingRecord.prescription,
            source: this.pendingRecord.source,
            confirmed: true
        };
        await ContextStore.getInstance().addRecord(confirmed);
        this.pushChat('assistant', `å·²ç»æŠŠ${confirmed.hospital}${confirmed.department}è¿™æ¬¡çš„è®°å½•å­˜å¥½äº†`);
        this.pendingRecord = null;
    }
    onDiscardPendingRecord() {
        this.pendingRecord = null;
    }
    /**
     * é‡‡é›†å½“å‰ä¸Šä¸‹æ–‡ï¼šä½ç½®ã€å¤©æ°”ã€æ—¶é—´
     *
     * âš ï¸ å®šä½ç›®å‰ä»æ˜¯å†™æ­»çš„ç»çº¬åº¦ï¼ˆæ­å·é™„è¿‘ï¼‰ã€‚
     * è¦æ¥çœŸå®å®šä½ï¼Œéœ€è¦åœ¨ module.json5 é‡Œå·²ç»å£°æ˜çš„ LOCATION æƒé™åŸºç¡€ä¸Šï¼Œ
     * è°ƒç”¨ @kit.LocationKit çš„ geoLocationManager.getCurrentLocation() è·å–çœŸå®ç»çº¬åº¦ï¼Œ
     * è¿™é‡Œå…ˆç”¨å›ºå®šåæ ‡ï¼Œä¿è¯æ²¡æœ‰å®šä½æƒé™æ—¶ä¹Ÿèƒ½è·‘é€šå…¨æµç¨‹æ¼”ç¤ºã€‚
     */
    async buildRuntimeContext() {
        const profile = ContextStore.getInstance().getProfile();
        const lat = 30.2741;
        const lng = 120.1551;
        // å¤©æ°”æ”¹ä¸ºçœŸå®æ¥å£ï¼ˆæœªé…ç½® Key æ—¶è‡ªåŠ¨é™çº§ä¸º Mockï¼Œè§ WeatherService.etsï¼‰
        const weather = await WeatherService.getWeather();
        return {
            currentLat: lat,
            currentLng: lng,
            currentAddress: profile.homeAddress,
            nowTs: Date.now(),
            weather: weather,
            trafficLevel: 'ç¼“è¡Œ'
        };
    }
