import { router } from '@kit.ArkUI';
import { common } from '@kit.AbilityKit';
import { photoAccessHelper } from '@kit.MediaLibraryKit';
import { image } from '@kit.ImageKit';
import { fileIo } from '@kit.CoreFileKit';
import {
  RuntimeContext, BusEvent, BusMessage, TaskPlan, TaskNode, TaskStatus, AgentResult,
  ServiceRecord, RecordSource
} from '../core/AgentTypes';
import { eventBus } from '../core/EventBus';
import { CentralAgent } from '../agents/CentralAgent';
import { ContextStore } from '../core/ContextStore';
import { DeviceSyncService } from '../services/DeviceSyncService';
import { WeatherService } from '../services/WeatherService';
import { OcrCaptureService } from '../services/OcrCaptureService';

/** å¯¹è¯æ°”æ³¡ */
class ChatItem {
  role: string = 'assistant';   // user / assistant
  text: string = '';

  constructor(role: string, text: string) {
    this.role = role;
    this.text = text;
  }
}

/** è¿›åº¦æ¡ç›® */
class ProgressItem {
  taskId: string = '';
  title: string = '';
  status: string = 'PENDING';

  constructor(taskId: string, title: string, status: string) {
    this.taskId = taskId;
    this.title = title;
    this.status = status;
  }
}

@Entry
@Component
struct Index {
  @State chats: ChatItem[] = [];
  @State progress: ProgressItem[] = [];
  @State listening: boolean = false;
  @State busy: boolean = false;
  @State inputText: string = '';
  @State pendingRecord: ServiceRecord | null = null;   // æ‹ç…§è¯†åˆ«å‡ºçš„å¾…ç¡®è®¤ç—…å†
  @State capturingOcr: boolean = false;

  private central: CentralAgent = new CentralAgent();
  private scroller: Scroller = new Scroller();

  aboutToAppear(): void {
    this.initServices();
    this.bindEvents();
    this.chats.push(new ChatItem('assistant',
      'æ‚¨å¥½ï¼Œæˆ‘æ˜¯æ™ºæŠ¤åŒè¡Œã€‚æ‚¨è¦å»åŒ»é™¢çœ‹ç—…ã€å–è¯ï¼Œç›´æ¥è·Ÿæˆ‘è¯´ä¸€å¥å°±è¡Œ'));
  }

  aboutToDisappear(): void {
    eventBus.clear();
    DeviceSyncService.clearReminders();
  }

  private async initServices(): Promise<void> {
    const ctx = getContext(this) as common.UIAbilityContext;
    await ContextStore.getInstance().init(ctx);
    DeviceSyncService.start();
    await this.seedDemoProfile();
  }

  /** æ¼”ç¤ºç”¨ï¼šé¢„ç½®ä¸€ä»½ç”¨æˆ·æ¡£æ¡ˆä¸ä¸€æ¡å†å²å°±è¯Šè®°å½• */
  private async seedDemoProfile(): Promise<void> {
    const store: ContextStore = ContextStore.getInstance();
    const p = store.getProfile();
    if (p.name.length > 0) {
      return;
    }
    await store.saveProfile({
      name: 'å¼ ç§€å…°',
      age: 72,
      homeAddress: 'å¹¸ç¦å°åŒº3æ ‹2å•å…ƒ',
      preferredHospitals: ['å¸‚ç¬¬ä¸€äººæ°‘åŒ»é™¢'],
      chronicTags: ['é«˜è¡€å‹'],
      accessibilityMode: true,
      emergencyContact: '13800000000'
    });
    await store.addRecord({
      recordId: 'r001',
      hospital: 'å¸‚ç¬¬ä¸€äººæ°‘åŒ»é™¢',
      department: 'å¿ƒè¡€ç®¡å†…ç§‘',
      doctorName: 'ç‹å»ºå›½ ä¸»ä»»åŒ»å¸ˆ',
      visitDate: '2026-07-20',
      followUpDays: 30,
      prescription: 'è‹¯ç£ºé…¸æ°¨æ°¯åœ°å¹³ç‰‡ æ¯æ—¥1æ¬¡ æ¯æ¬¡5mg',
      source: RecordSource.MANUAL_INPUT,
      confirmed: true   // æ¼”ç¤ºæ•°æ®è§†ä¸ºå·²æ ¸å®ï¼ŒçœŸå®åœºæ™¯ä¸‹å¿…é¡»èµ°ç”¨æˆ·ç¡®è®¤
    });
  }

  /** è®¢é˜… Agent å±‚äº‹ä»¶ï¼Œé©±åŠ¨ UI æ›´æ–° */
  private bindEvents(): void {
    eventBus.on(BusEvent.PLAN_UPDATED, (msg: BusMessage) => {
      const plan: TaskPlan = JSON.parse(msg.payload) as TaskPlan;
      const list: ProgressItem[] = [];
      for (let i = 0; i < plan.nodes.length; i++) {
        const n: TaskNode = plan.nodes[i];
        list.push(new ProgressItem(n.id, n.title, n.status as string));
      }
      this.progress = list;
    });

    eventBus.on(BusEvent.TASK_STARTED, (msg: BusMessage) => {
      const obj: Record<string, string> = JSON.parse(msg.payload) as Record<string, string>;
      this.updateProgress(obj['taskId'], 'RUNNING');
    });

    eventBus.on(BusEvent.TASK_FINISHED, (msg: BusMessage) => {
      const r: AgentResult = JSON.parse(msg.payload) as AgentResult;
      this.updateProgress(r.taskId, r.success ? 'SUCCESS' : 'FAILED');
    });

    eventBus.on(BusEvent.SPEAK, (msg: BusMessage) => {
      const obj: Record<string, string> = JSON.parse(msg.payload) as Record<string, string>;
      this.pushChat('assistant', obj['text']);
    });

    eventBus.on(BusEvent.ANOMALY_DETECTED, () => {
      this.progress = [];
    });
  }

  private updateProgress(taskId: string, status: string): void {
    const list: ProgressItem[] = [];
    for (let i = 0; i < this.progress.length; i++) {
      const p: ProgressItem = this.progress[i];
      if (p.taskId === taskId) {
        list.push(new ProgressItem(p.taskId, p.title, status));
      } else {
        list.push(p);
      }
    }
    this.progress = list;
  }

  private pushChat(role: string, text: string): void {
    this.chats.push(new ChatItem(role, text));
    setTimeout(() => {
      this.scroller.scrollEdge(Edge.Bottom);
    }, 80);
  }

  /** å‘èµ·ä¸€æ¬¡è¯·æ±‚ */
  private async submit(text: string): Promise<void> {
    if (text.length === 0 || this.busy) {
      return;
    }
    this.busy = true;
    this.pushChat('user', text);
    this.inputText = '';

    try {
      const rt: RuntimeContext = await this.buildRuntimeContext();
      const clarify: string = await this.central.handleUserRequest(text, rt);
      if (clarify.length > 0) {
        this.pushChat('assistant', clarify);
      }
    } catch (e) {
      this.pushChat('assistant', 'åˆšæ‰æ²¡å¤„ç†å¥½ï¼Œæ‚¨å†è¯´ä¸€æ¬¡å¥½å—');
      console.error(`[Index] submit error: ${e}`);
    } finally {
      this.busy = false;
    }
  }

  // ==================== æ‹ç…§å½•å…¥ç—…å† ====================

  /**
   * ç”¨æˆ·ç‚¹"æ‹ç…§å½•å…¥"ï¼šé€‰ç…§ç‰‡ â†’ OCR â†’ å¤§æ¨¡å‹ç»“æ„åŒ– â†’ å¼¹å‡ºå¾…ç¡®è®¤å¡ç‰‡
   * å…¨ç¨‹ä¸ç›´æ¥å†™å…¥æ­£å¼ç—…å†ï¼Œå¿…é¡»ç­‰ç”¨æˆ·ç‚¹"ç¡®è®¤æ— è¯¯"æ‰ç”Ÿæ•ˆï¼ˆè§ onConfirmPendingRecordï¼‰
   */
  private async onCapturePhoto(): Promise<void> {
    if (this.capturingOcr) {
      return;
    }
    this.capturingOcr = true;
    try {
      const picker: photoAccessHelper.PhotoViewPicker = new photoAccessHelper.PhotoViewPicker();
      const result = await picker.select({
        MIMEType: photoAccessHelper.PhotoViewMIMETypes.IMAGE_TYPE,
        maxSelectNumber: 1
      });
      if (result.photoUris === undefined || result.photoUris.length === 0) {
        this.capturingOcr = false;
        return;
      }

      const pixelMap: image.PixelMap = await this.loadPixelMap(result.photoUris[0]);
      const record: ServiceRecord | null = await OcrCaptureService.captureFromPhoto(pixelMap);

      if (record === null) {
        this.pushChat('assistant', 'è¿™å¼ ç…§ç‰‡æ²¡èƒ½è¯†åˆ«å‡ºç—…å†ä¿¡æ¯ï¼Œè¦ä¸æ¢ä¸€å¼ æ¸…æ¥šç‚¹çš„è¯•è¯•');
      } else {
        this.pendingRecord = record;
      }
    } catch (e) {
      console.error(`[Index] capture photo failed: ${e}`);
      this.pushChat('assistant', 'æ‹ç…§è¯†åˆ«æ²¡æˆåŠŸï¼Œæ‚¨å¯ä»¥å†è¯•ä¸€æ¬¡');
    } finally {
      this.capturingOcr = false;
    }
  }

  /** æŠŠç…§ç‰‡ URI è¯»æˆ PixelMapï¼Œä¾› OCR ä½¿ç”¨ */
  private async loadPixelMap(uri: string): Promise<image.PixelMap> {
    const file = await fileIo.open(uri, fileIo.OpenMode.READ_ONLY);
    try {
      const source: image.ImageSource = image.createImageSource(file.fd);
      const pixelMap: image.PixelMap = await source.createPixelMap();
      await source.release();
      return pixelMap;
    } finally {
      await fileIo.close(file.fd);
    }
  }

  /** ç”¨æˆ·ç‚¹"ç¡®è®¤æ— è¯¯"ï¼šè¿™æ—¶å€™æ‰çœŸæ­£å†™å…¥ç—…å†åº“ */
  private async onConfirmPendingRecord(): Promise<void> {
    if (this.pendingRecord === null) {
      return;
    }
    const confirmed: ServiceRecord = {
      recordId: this.pendingRecord.recordId,
      hospital: this.pendingRecord.hospital,
      department: this.pendingRecord.department,
      doctorName: this.pendingRecord.doctorName,
      visitDate: this.pendingRecord.visitDate,
      followUpDays: this.pendingRecord.followUpDays,
      prescription: this.pendingRecord.prescription,
      source: this.pendingRecord.source,
      confirmed: true
    };
    await ContextStore.getInstance().addRecord(confirmed);
    this.pushChat('assistant', `å·²ç»æŠŠ${confirmed.hospital}${confirmed.department}è¿™æ¬¡çš„è®°å½•å­˜å¥½äº†`);
    this.pendingRecord = null;
  }

  private onDiscardPendingRecord(): void {
    this.pendingRecord = null;
  }

  /**
   * é‡‡é›†å½“å‰ä¸Šä¸‹æ–‡ï¼šä½ç½®ã€å¤©æ°”ã€æ—¶é—´
   *
   * âš ï¸ å®šä½ç›®å‰ä»æ˜¯å†™æ­»çš„ç»çº¬åº¦ï¼ˆæ­å·é™„è¿‘ï¼‰ã€‚
   * è¦æ¥çœŸå®å®šä½ï¼Œéœ€è¦åœ¨ module.json5 é‡Œå·²ç»å£°æ˜çš„ LOCATION æƒé™åŸºç¡€ä¸Šï¼Œ
   * è°ƒç”¨ @kit.LocationKit çš„ geoLocationManager.getCurrentLocation() è·å–çœŸå®ç»çº¬åº¦ï¼Œ
   * è¿™é‡Œå…ˆç”¨å›ºå®šåæ ‡ï¼Œä¿è¯æ²¡æœ‰å®šä½æƒé™æ—¶ä¹Ÿèƒ½è·‘é€šå…¨æµç¨‹æ¼”ç¤ºã€‚
   */
  private async buildRuntimeContext(): Promise<RuntimeContext> {
    const profile = ContextStore.getInstance().getProfile();
    const lat: number = 30.2741;
    const lng: number = 120.1551;
    // å¤©æ°”æ”¹ä¸ºçœŸå®æ¥å£ï¼ˆæœªé…ç½® Key æ—¶è‡ªåŠ¨é™çº§ä¸º Mockï¼Œè§ WeatherService.etsï¼‰
    const weather: string = await WeatherService.getWeather();
    return {
      currentLat: lat,
      currentLng: lng,
      currentAddress: profile.homeAddress,
      nowTs: Date.now(),
      weather: weather,
      trafficLevel: 'ç¼“è¡Œ'
    };
  }

  /** æ¨¡æ‹Ÿè¯­éŸ³è¾“å…¥ */
  private onVoiceTap(): void {
    if (this.busy) {
      return;
    }
    this.listening = true;
    // TODO: æ¥å…¥ç³»ç»Ÿè¯­éŸ³è¯†åˆ«ï¼Œæ­¤å¤„ç”¨å›ºå®šè¯­æ–™æ¨¡æ‹Ÿ
    setTimeout(() => {
      this.listening = false;
      this.submit('æˆ‘è¦å»ç¬¬ä¸€äººæ°‘åŒ»é™¢æ‹¿é«˜è¡€å‹è¯');
    }, 1200);
  }

  // ==================== UI ====================

  @Builder
  ChatBubble(item: ChatItem) {
    Row() {
      if (item.role === 'user') {
        Blank()
        Text(item.text)
          .fontSize(21)
          .fontColor('#FFFFFF')
          .padding({ left: 18, right: 18, top: 14, bottom: 14 })
          .backgroundColor('#2E6F8E')
          .borderRadius(18)
          .constraintSize({ maxWidth: '78%' })
      } else {
        Text(item.text)
          .fontSize(21)
          .fontColor('#22303C')
          .lineHeight(32)
          .padding({ left: 18, right: 18, top: 14, bottom: 14 })
          .backgroundColor('#FFFFFF')
          .borderRadius(18)
          .constraintSize({ maxWidth: '82%' })
        Blank()
      }
    }
    .width('100%')
    .margin({ bottom: 14 })
  }

  @Builder
  PendingInfoRow(label: string, value: string) {
    Row() {
      Text(label)
        .fontSize(16)
        .fontColor('#7A8A96')
        .width(70)
      Text(value.length > 0 ? value : 'æœªè¯†åˆ«åˆ°ï¼Œå¯ç¨åæ‰‹åŠ¨è¡¥å……')
        .fontSize(16)
        .fontColor(value.length > 0 ? '#22303C' : '#B0BAC2')
        .layoutWeight(1)
    }
    .width('100%')
    .padding({ top: 6, bottom: 6 })
  }

  @Builder
  ProgressRow(item: ProgressItem) {
    Row() {
      Text(this.statusIcon(item.status))
        .fontSize(20)
        .width(34)
      Text(item.title)
        .fontSize(19)
        .fontColor(item.status === 'SUCCESS' ? '#3B7A57' : '#4A5A66')
        .layoutWeight(1)
      Text(this.statusLabel(item.status))
        .fontSize(16)
        .fontColor('#8A9AA6')
    }
    .width('100%')
    .padding({ top: 10, bottom: 10 })
  }

  private statusIcon(s: string): string {
    if (s === 'SUCCESS') {
      return 'âœ“';
    }
    if (s === 'RUNNING') {
      return 'â—';
    }
    if (s === 'FAILED') {
      return '!';
    }
    return 'â—‹';
  }

  private statusLabel(s: string): string {
    if (s === 'SUCCESS') {
      return 'å·²å®Œæˆ';
    }
    if (s === 'RUNNING') {
      return 'å¤„ç†ä¸­';
    }
    if (s === 'FAILED') {
      return 'æœªæˆåŠŸ';
    }
    return 'ç­‰å¾…ä¸­';
  }

  build() {
    Column() {
      // é¡¶éƒ¨æ ‡é¢˜
      Row() {
        Column() {
          Text('æ™ºæŠ¤åŒè¡Œ')
            .fontSize(26)
            .fontWeight(FontWeight.Bold)
            .fontColor('#1B2A34')
          Text('è¯´ä¸€å¥è¯ï¼Œæˆ‘æ¥å®‰æ’')
            .fontSize(15)
            .fontColor('#7A8A96')
            .margin({ top: 2 })
        }
        .alignItems(HorizontalAlign.Start)
        Blank()
        Text('é™ªè¯Šè®°å½•')
          .fontSize(16)
          .fontColor('#2E6F8E')
          .onClick(() => {
            router.pushUrl({ url: 'pages/JourneyPage' });
          })
        Text('æ‹ç…§å½•å…¥')
          .fontSize(16)
          .fontColor('#2E6F8E')
          .margin({ left: 16 })
          .onClick(() => {
            this.onCapturePhoto();
          })
      }
      .width('100%')
      .padding({ left: 20, right: 20, top: 16, bottom: 12 })

      // æ‹ç…§è¯†åˆ«å¾…ç¡®è®¤å¡ç‰‡ â€”â€” è¯†åˆ«ç»“æœä¸ç›´æ¥ç”Ÿæ•ˆï¼Œå¿…é¡»ç”¨æˆ·ç‚¹ç¡®è®¤
      if (this.pendingRecord !== null) {
        Column() {
          Row() {
            Text('è¯†åˆ«åˆ°ä¸€æ¡ç—…å†ï¼Œéº»çƒ¦æ‚¨çœ‹çœ‹å¯¹ä¸å¯¹')
              .fontSize(17)
              .fontWeight(FontWeight.Medium)
              .fontColor('#1B2A34')
            Blank()
          }
          .width('100%')
          .margin({ bottom: 10 })

          this.PendingInfoRow('åŒ»é™¢', this.pendingRecord.hospital)
          this.PendingInfoRow('ç§‘å®¤', this.pendingRecord.department)
          this.PendingInfoRow('åŒ»ç”Ÿ', this.pendingRecord.doctorName)
          this.PendingInfoRow('æ—¥æœŸ', this.pendingRecord.visitDate)
          this.PendingInfoRow('ç”¨è¯', this.pendingRecord.prescription)

          Row() {
            Button('ä¸å¯¹ï¼Œå–æ¶ˆ')
              .fontSize(16)
              .fontColor('#7A8A96')
              .backgroundColor('#EEF3F6')
              .layoutWeight(1)
              .margin({ right: 10 })
              .onClick(() => {
                this.onDiscardPendingRecord();
              })
            Button('ç¡®è®¤æ— è¯¯')
              .fontSize(16)
              .fontColor('#FFFFFF')
              .backgroundColor('#2E6F8E')
              .layoutWeight(1)
              .onClick(() => {
                this.onConfirmPendingRecord();
              })
          }
          .width('100%')
          .margin({ top: 12 })
        }
        .width('90%')
        .padding(18)
        .backgroundColor('#FFFFFF')
        .borderRadius(16)
        .margin({ bottom: 12 })
      }

      // è¿›åº¦é¢æ¿ï¼šè®©ç”¨æˆ·çœ‹è§ Agent æ­£åœ¨æ›¿ä»–åšä»€ä¹ˆ
      if (this.progress.length > 0) {
        Column() {
          Text('æ­£åœ¨ä¸ºæ‚¨å®‰æ’')
            .fontSize(17)
            .fontColor('#5A6A76')
            .width('100%')
            .margin({ bottom: 4 })
          ForEach(this.progress, (item: ProgressItem) => {
            this.ProgressRow(item);
          }, (item: ProgressItem) => item.taskId)
        }
        .width('90%')
        .padding(18)
        .backgroundColor('#FFFFFF')
        .borderRadius(16)
        .margin({ bottom: 12 })
      }

      // å¯¹è¯åŒº
      Scroll(this.scroller) {
        Column() {
          ForEach(this.chats, (item: ChatItem, idx: number) => {
            this.ChatBubble(item);
          }, (item: ChatItem, idx: number) => `${idx}_${item.text.length}`)
        }
        .width('100%')
        .padding({ left: 18, right: 18 })
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)

      // åº•éƒ¨è¾“å…¥åŒº
      Column() {
        Row() {
          TextInput({ text: this.inputText, placeholder: 'ä¹Ÿå¯ä»¥æ‰“å­—å‘Šè¯‰æˆ‘' })
            .fontSize(19)
            .height(52)
            .layoutWeight(1)
            .backgroundColor('#FFFFFF')
            .borderRadius(26)
            .onChange((v: string) => {
              this.inputText = v;
            })
          Button('å‘é€')
            .fontSize(18)
            .height(52)
            .margin({ left: 10 })
            .backgroundColor('#2E6F8E')
            .onClick(() => {
              this.submit(this.inputText);
            })
        }
        .width('92%')
        .margin({ bottom: 14 })

        // å¤§å·è¯­éŸ³æŒ‰é’® â€”â€” è€äººä¸»è¦å…¥å£
        Button() {
          Column() {
            Text(this.listening ? 'æ­£åœ¨å¬â€¦' : 'æŒ‰ä½è¯´è¯')
              .fontSize(23)
              .fontColor('#FFFFFF')
              .fontWeight(FontWeight.Medium)
          }
        }
        .width('84%')
        .height(72)
        .borderRadius(36)
        .backgroundColor(this.listening ? '#1F566E' : '#2E6F8E')
        .enabled(!this.busy)
        .onClick(() => {
          this.onVoiceTap();
        })
      }
      .width('100%')
      .padding({ top: 12, bottom: 22 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#EEF3F6')
  }
}
