        const ctx = getContext(this);
        const departTime = this.travel === null ? this.appt.visitTime : this.travel.departTime;
        const detail = this.travel === null ? '' : this.travel.suggestion;
        const snapshot = {
            hasPlan: true,
            title: `${this.appt.visitDate} ${this.appt.visitTime} ${this.appt.department}`,
            nextAction: `${departTime} å‡ºå‘`,
            detail: detail,
            hospital: this.appt.hospitalName,
            stepIndex: 1,
            stepTotal: this.reminders.length,
            updatedAt: Date.now()
