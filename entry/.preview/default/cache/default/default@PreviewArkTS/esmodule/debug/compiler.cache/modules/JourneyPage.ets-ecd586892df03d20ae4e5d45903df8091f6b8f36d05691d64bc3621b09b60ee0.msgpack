    /** ä»Žå…±äº«é»‘æ¿å–å‡ºå„ Agent çš„äº§å‡º */
    loadFromBlackboard() {
        const medical = blackboard.getResultByAgent('MedicalAgent');
        if (medical !== undefined && medical.data.length > 0) {
            const d = JSON.parse(medical.data);
            this.appt = d['appointment'];
        }
        const travelRes = blackboard.getResultByAgent('TravelAgent');
        if (travelRes !== undefined && travelRes.data.length > 0) {
            const d = JSON.parse(travelRes.data);
            this.travel = d['travelPlan'];
        }
        const navRes = blackboard.getResultByAgent('NavigationAgent');
        if (navRes !== undefined && navRes.data.length > 0) {
            const d = JSON.parse(navRes.data);
            this.nav = d['navPlan'];
        }
        const remindRes = blackboard.getResultByAgent('ReminderAgent');
        if (remindRes !== undefined && remindRes.data.length > 0) {
            const d = JSON.parse(remindRes.data);
            this.reminders = d['reminders'];
        }
    }
